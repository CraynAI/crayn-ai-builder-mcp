{
	"name": "crayn-ai/crayn-ai-builder-mcp",
	"description": "Bundles the official WordPress MCP Adapter and registers a full set of safe, previewable, revertible abilities (tools) for AI agents.",
	"license": "GPL-2.0-or-later",
	"type": "wordpress-plugin",
	"keywords": [
		"wordpress",
		"mcp",
		"abilities-api",
		"ai",
		"agents"
	],
	"authors": [
		{
			"name": "Yunus Doğukan OĞLAKCI (CraynAI)",
			"homepage": "https://www.crayn.ai/"
		}
	],
	"homepage": "https://www.crayn.ai/",
	"config": {
		"platform": {
			"php": "7.4"
		},
		"sort-packages": true,
		"optimize-autoloader": true,
		"preferred-install": "dist",
		"allow-plugins": {
			"automattic/jetpack-autoloader": true
		}
	},
	"autoload": {
		"classmap": [
			"includes/"
		]
	},
	"require": {
		"php": "^7.4 || ^8.0",
		"automattic/jetpack-autoloader": "^6.0",
		"wordpress/mcp-adapter": "^0.7.0"
	}
}
